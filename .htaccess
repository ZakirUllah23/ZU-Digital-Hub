# ==============================================================================
# ZU Digital Hub - Apache Production Configuration
# Error Handling, HTTPS Redirection, Compression, Caching & Security Headers
# ==============================================================================

# 1. Custom 404 Error Page (Returns Genuine HTTP 404 Status)
ErrorDocument 404 /404.html

# 2. HTTPS Redirection & Canonical Domain (Safe for Local Development)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP to HTTPS for live domain without breaking localhost / local dev environments
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www canonical domain (production only)
  RewriteCond %{HTTP_HOST} ^www\.zudigitalhub\.com$ [NC]
  RewriteRule ^(.*)$ https://zudigitalhub.com/$1 [L,R=301]
</IfModule>

# 3. Character Encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# 4. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Leverage Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages - 2 hours cache for freshness
  ExpiresByType text/html "access plus 2 hours"

  # CSS and JavaScript - 1 hour (allows quick propagation of stylesheet/script updates)
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"

  # Images and Media - 1 month
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"

  # Data / XML
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 6. Security & Performance Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>
